# Server
PORT=3100
HOST=0.0.0.0
PUBLIC_URL=https://mcp.lavarage.xyz
WEB_APP_URL=https://v2.lavarage.xyz

# Required: Lavarage API
LAVARAGE_API_URL=https://api.lavarage.xyz
LAVARAGE_API_KEY=your-mcp-partner-api-key

# Required: Privy (user authentication + optional server-wallet signing)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_SIGNING_KEY=your-privy-signing-key-base64

# Optional: Safety limits
LAVARAGE_MAX_POSITION_SOL=10
